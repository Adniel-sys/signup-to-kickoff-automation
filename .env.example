# Copy to apps/web/.env.local for local dev. Never commit real values.
# Website vars are validated at startup by apps/web/lib/env.ts and lib/server/env.ts.

# --- Shared: website + n8n ---------------------------------------------------
# Generate with: openssl rand -hex 32
ONBOARD_WEBHOOK_SECRET=

# --- Website ------------------------------------------------------------------
N8N_BASE_URL=https://your-subdomain.ngrok-free.dev
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SLACK_SIGNING_SECRET=
# Cloudflare's always-pass test keys; replace with real keys before deploying.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- n8n only (set as n8n credentials, NOT in the website / Vercel) -----------
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
