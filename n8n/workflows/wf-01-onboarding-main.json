      "parameters": {
        "operation": "executeQuery",
        "query": "with new_client as (\n  insert into public.clients\n    (submission_id, company_name, contact_name, contact_email, service_tier, intake_raw)\n  values\n    ($1::uuid, $2, $3, $4, $5, $6::jsonb)\n  on conflict (submission_id) do nothing\n  returning id\n),\nnew_run as (\n  insert into public.onboarding_runs (client_id, status, n8n_execution_id)\n  select id, 'received', $7\n  from new_client\n  returning id\n)\nselect id as run_id from new_run;",
        "options": {
          "queryReplacement": "={{ [   $json.body.submission_id,   $json.body.company_name,   $json.body.contact_name,   $json.body.contact_email,   $json.body.service_tier,   JSON.stringify($json.body),   $execution.id ] }}"
        }
